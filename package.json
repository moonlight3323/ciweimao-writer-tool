{
  "name": "ciweimao-author-tool",
  "productName": "刺猬猫作家助手",
  "version": "1.1.3",
  "description": "刺猬猫作者后台数据整理、评论审查、码字台与一键投递、插件中心的 Windows 桌面工具",
  "main": "src/main/main.js",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "check": "node tools/check.js",
    "test": "node --test tests/*.test.js tools/test-*.js",
    "test:ui": "node tools/ui-wordlib.js",
    "verify:portable": "node tools/verify-portable.js",
    "install:electron": "node node_modules/electron/install.js",
    "start": "electron .",
    "build": "node tools/build-portable.js",
    "pack": "node tools/finish-portable.js"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "rcedit": "^5.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
